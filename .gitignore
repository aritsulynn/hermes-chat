# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# build output
dist/
*.tsbuildinfo

# Vite's dep-optimization cache. Normally this lands in node_modules/.vite, but
# it sits at the repo root here — and unignored it poisons `npm run lint` and
# `npm run format:check` with thousands of errors from prebundled vendor code.
.vite/

# agent tooling output (screenshots and session state from the browser panel)
.openchamber/
.playwright-cli/

# local agent skills — installed per machine, not part of the app
.agents/
skills-lock.json

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# local env files — the gateway host is entered by the user, not configured here
.env*
!.env.example
!.env.sample

# macOS
.DS_Store
*.pem

# Android (Capacitor shell is tracked for its custom source — MainActivity,
# NativeHttpPlugin, manifest flags — but never its local outputs)
android/local.properties
android/.gradle/
android/build/
android/app/build/
android/captures/
android/.idea/
*.apk
