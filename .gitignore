# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# build output
dist/
*.tsbuildinfo

# agent tooling output (screenshots from the browser panel)
.openchamber/

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# local env files — the gateway host is entered by the user, not configured here
.env*
!.env.example
!.env.sample

# macOS
.DS_Store
*.pem

# working docs (manual QA plans, audits, refactor plans) — local only
docs/
